package web

import (
	"strconv"

	"github.com/newlix/crashcart/internal/db/sqlc"
)

// Stat cards shared by the dashboard and the portal: Crashes / Errors
// (number + chart) and Issues (top-10 list). One markup source so both
// pages can't drift.

// StatToggle marks a card title as a filter toggle.
type StatToggle struct {
	Active bool
	Attrs  templ.Attributes
}

func boolAttr(b bool) string {
	if b {
		return "true"
	}
	return "false"
}

templ StatCard(title, value string, toggle *StatToggle) {
	<div data-slot="card" data-size="sm" class="group/card stat-card" data-active={ boolAttr(toggle != nil && toggle.Active) }>
		<header data-slot="card-header">
			if toggle != nil {
				<button type="button" class="stat-title" title={ toggleTitle(title, toggle.Active) } { toggle.Attrs... }>
					{ title }
					if toggle.Active {
						<span class="stat-filter">FILTER</span>
					} else {
						<span class="stat-title-hint">· click to filter</span>
					}
				</button>
			} else {
				<h2 class="stat-title">{ title }</h2>
			}
			<div data-slot="card-action">
				<span class="stat-value">{ value }</span>
			</div>
		</header>
		<section class="px-2 pb-2">
			{ children... }
		</section>
	</div>
}

func toggleTitle(title string, active bool) string {
	if active {
		return "Remove filter"
	}
	return "Show only " + lower(title)
}

// LineChart is a placeholder canvas; app.js renders it with Chart.js from
// the embedded JSON (labels + series with severity color tokens).
templ LineChart(data ChartData) {
	if data.Empty() {
		<div class="chart-box flex items-center justify-center">
			<p class="text-xs text-muted-foreground">No data in this window</p>
		</div>
	} else {
		<div class="chart-box">
			<canvas data-chart={ jsonAttr(data) } aria-label="chart"></canvas>
		</div>
	}
}

templ Legend(series []ChartSeries) {
	<div class="chart-legend">
		for _, s := range series {
			<span class="inline-flex items-center">
				<span class="swatch" style={ templ.SafeCSS("background:var(--" + s.Token + ")") }></span>
				{ s.Name }
			</span>
		}
	</div>
}

templ CrashChart(data ChartData) {
	@LineChart(data)
}

templ VolumeChart(data ChartData) {
	@LineChart(data)
	@Legend(data.Series)
}

// IssueItem is one row of the Issues card (htmx row or plain link).
type IssueItem struct {
	Key      string
	Title    string
	Count    int64
	RowAttrs templ.Attributes // htmx navigation (dashboard)
	Href     string           // plain link (portal)
}

templ IssuesCard(total int, items []IssueItem) {
	<div data-slot="card" data-size="sm" class="group/card stat-card">
		<header data-slot="card-header">
			<h2 class="stat-title">Issues</h2>
			<div data-slot="card-action">
				<span class="stat-value">{ strconv.Itoa(total) }</span>
			</div>
		</header>
		<section class="px-0 pb-0">
			if len(items) == 0 {
				<div class="issue-list flex items-center justify-center">
					<p class="text-xs text-muted-foreground">No issues in this window</p>
				</div>
			} else {
				<div class="issue-list">
					<table data-slot="table">
						<thead data-slot="table-header">
							<tr>
								<th data-slot="table-head" class="w-8">#</th>
								<th data-slot="table-head">Error</th>
								<th data-slot="table-head" class="text-right">Count</th>
							</tr>
						</thead>
						<tbody data-slot="table-body">
							for idx, i := range items {
								<tr data-slot="table-row" aria-label={ i.Title + " (" + strconv.FormatInt(i.Count, 10) + " events)" } { i.RowAttrs... }>
									<td data-slot="table-cell" class="issue-rank">{ strconv.Itoa(idx + 1) }</td>
									<td data-slot="table-cell" class="issue-title" title={ i.Title }>
										if i.Href != "" {
											<a href={ templ.SafeURL(i.Href) }>{ i.Title }</a>
										} else {
											{ i.Title }
										}
									</td>
									<td data-slot="table-cell" class="issue-count">{ strconv.FormatInt(i.Count, 10) }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</section>
	</div>
}

// dashboardIssueItems turns issues into htmx rows filtering by fingerprint.
func dashboardIssueItems(issues []sqlc.Issue, s ViewState) []IssueItem {
	out := make([]IssueItem, 0, len(issues))
	for _, i := range TopIssues(issues, 10) {
		out = append(out, IssueItem{
			Key:      i.Fingerprint,
			Title:    i.Title,
			Count:    i.EventCount,
			RowAttrs: hxRowNav(s.WithFilter("fingerprint", i.Fingerprint).Href()),
		})
	}
	return out
}
