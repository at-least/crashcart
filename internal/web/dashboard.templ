package web

import (
	"strconv"
	"strings"

	"github.com/newlix/crashcart/internal/config"
	"github.com/newlix/crashcart/internal/store"
)

func lower(s string) string { return strings.ToLower(s) }

func chipLabel(col string, tags []config.CustomTag) string {
	if l, ok := FilterLabels[col]; ok {
		return l
	}
	for _, t := range tags {
		if t.Key == col {
			return t.Label
		}
	}
	return col
}

// chipFilters lists the active filters in stable order, hiding the level
// chip when the Errors toggle already overrides it.
func chipFilters(s ViewState) [][2]string {
	var out [][2]string
	for _, k := range sortedKeys(s.Filters) {
		if s.Err && k == "level" {
			continue
		}
		out = append(out, [2]string{k, s.Filters[k]})
	}
	return out
}

// Dashboard: stat cards, toolbar, chips, event table, pager.
templ Dashboard(d DashboardData, s ViewState, tags []config.CustomTag) {
	<div class="page pt-4 pb-8">
		<div class="stat-grid">
			@StatCard("Crashes", strconv.FormatInt(d.Stats.Crash, 10), &StatToggle{Active: s.Crash, Attrs: hxNav(s.WithCrash(!s.Crash).Href())}) {
				@CrashChart(d.Timeline)
			}
			@StatCard("Errors", strconv.FormatInt(d.Stats.Error, 10), &StatToggle{Active: s.Err, Attrs: hxNav(s.WithErr(!s.Err).Href())}) {
				@VolumeChart(d.Volume)
			}
			@IssuesCard(len(d.Issues), dashboardIssueItems(d.Issues, s))
		</div>
		<div class="toolbar">
			<div class="toolbar-group">
				<label data-slot="label" class="toolbar-label" for="release-select">Release</label>
				<span data-slot="native-select-wrapper">
					<select
						id="release-select"
						name="release"
						data-slot="native-select"
						class="h-8 text-xs"
						hx-get={ s.WithRelease("").Href() }
						hx-target="#shell"
						hx-select="#shell"
						hx-swap="outerHTML"
						hx-include="this"
						hx-trigger="change"
					>
						<option value="">All releases</option>
						for _, v := range d.Versions {
							<option value={ v } selected?={ v == s.Release }>{ v }</option>
						}
					</select>
					@ChevronIcon()
				</span>
				if s.Release != "" {
					<button type="button" data-slot="button" data-variant="ghost" data-size="icon-sm" title="Reset release" aria-label="Reset release" { hxNav(s.WithRelease("").Href())... }>
						@XIcon()
					</button>
				}
			</div>
			<form class="toolbar-search" hx-get={ s.Href() } hx-target="#shell" hx-select="#shell" hx-swap="outerHTML" hx-include="this">
				<span data-slot="native-select-wrapper">
					<select name="search_col" aria-label="Search field" data-slot="native-select" class="h-8 text-xs">
						for _, c := range SearchColumns {
							<option value={ c[0] }>{ c[1] }</option>
						}
						for _, t := range tags {
							<option value={ t.Key }>{ t.Label }</option>
						}
					</select>
					@ChevronIcon()
				</span>
				<input type="search" name="search_q" aria-label="Search query" placeholder="Search…" data-slot="input" class="h-8 w-52 max-w-full text-xs"/>
				<button type="submit" data-slot="button" data-variant="outline" data-size="sm">Search</button>
			</form>
		</div>
		if len(chipFilters(s)) > 0 || s.Crash || s.Err {
			<div class="chip-row">
				if s.Crash {
					<button type="button" class="chip" { hxNav(s.WithCrash(false).Href())... }>
						crashed
						@XIcon()
					</button>
				}
				if s.Err {
					<button type="button" class="chip" { hxNav(s.WithErr(false).Href())... }>
						<span class="chip-key">level:</span>fatal,error
						@XIcon()
					</button>
				}
				for _, f := range chipFilters(s) {
					<button type="button" class="chip" { hxNav(s.WithFilter(f[0], "").Href())... }>
						<span class="chip-key">{ chipLabel(f[0], tags) }:</span>
						{ chipValue(f[0], f[1]) }
						@XIcon()
					</button>
				}
				<button type="button" data-slot="button" data-variant="ghost" data-size="xs" class="chip-clear" { hxNav(s.Cleared().Href())... }>Clear all</button>
			</div>
		}
		@EventTable(d.Events, s, tags)
		if len(d.Events) > 0 || s.Page > 0 {
			<nav class="pager" aria-label="Event pages">
				<span>
					if len(d.Events) > 0 {
						Showing <span class="pager-page">{ strconv.Itoa(s.Page*PageSize + 1) }</span>–<span class="pager-page">{ strconv.Itoa(s.Page*PageSize + len(d.Events)) }</span>
					} else {
						No more events
					}
					{ " · page " }
					<span class="pager-page">{ strconv.Itoa(s.Page + 1) }</span>
				</span>
				<div data-slot="button-group" role="group">
					if s.Page > 0 {
						<button type="button" data-slot="button" data-variant="outline" data-size="sm" aria-label="Previous page" { hxNav(s.WithPage(s.Page - 1).Href())... }>
							@ChevronLeftIcon()
							Previous
						</button>
					} else {
						<button type="button" data-slot="button" data-variant="outline" data-size="sm" disabled aria-label="Previous page">
							@ChevronLeftIcon()
							Previous
						</button>
					}
					if len(d.Events) >= PageSize {
						<button type="button" data-slot="button" data-variant="outline" data-size="sm" aria-label="Next page" { hxNav(s.WithPage(s.Page + 1).Href())... }>
							Next
							@ChevronRightIcon()
						</button>
					} else {
						<button type="button" data-slot="button" data-variant="outline" data-size="sm" disabled aria-label="Next page">
							Next
							@ChevronRightIcon()
						</button>
					}
				</div>
			</nav>
		}
	</div>
}

// chipValue shortens fingerprints (32 hex chars) for display.
func chipValue(col, v string) string {
	if col == "fingerprint" && len(v) > 12 {
		return v[:12] + "…"
	}
	return v
}

func isCrashRow(e store.Event) bool {
	return e.Level == "fatal" || (e.Handled != nil && !*e.Handled)
}

func rowLevel(e store.Event) string {
	if isCrashRow(e) {
		return "fatal"
	}
	return levelKey(e.Level)
}

// EventTable is the dense log table: level badges, crash marks, clickable
// filter values, custom tag columns.
templ EventTable(events []store.Event, s ViewState, tags []config.CustomTag) {
	if len(events) == 0 {
		<div class="empty-frame">
			<p class="empty-title">No events found</p>
			<p class="empty-desc">Try a wider window or remove a filter.</p>
		</div>
	} else {
		<div class="log-frame" data-slot="table-container">
			<table class="log-table">
				<thead>
					<tr>
						<th style="width:150px">Time</th>
						<th style="width:90px">Level</th>
						<th style="width:80px">Crash</th>
						<th>Message</th>
						<th style="width:90px">Release</th>
						<th style="width:70px">OS</th>
						<th style="width:110px">Model</th>
						<th style="width:110px">User</th>
						for _, t := range tags {
							<th style="width:100px">{ t.Label }</th>
						}
					</tr>
				</thead>
				<tbody>
					for _, e := range events {
						<tr data-level={ rowLevel(e) } tabindex="0" aria-label={ e.Level + " " + e.Message } { hxDetail(s.Base, e.ID)... }>
							<td class="cell-time" title={ formatTime(e.OccurredAt) }>{ timeAgo(e.OccurredAt, now()) }</td>
							<td>
								<button type="button" class="level-badge" data-level={ levelKey(e.Level) } title={ "Filter level: " + e.Level } { hxNav(s.WithFilter("level", e.Level).Href())... }>{ e.Level }</button>
							</td>
							<td>
								if isCrashRow(e) {
									<button type="button" class="crash-badge" title="Filter: crashed only" { hxNav(s.WithCrash(true).Href())... }>crashed</button>
								} else if e.Handled != nil && *e.Handled {
									<span class="caught-mark">caught</span>
								} else {
									<span class="null-mark">—</span>
								}
							</td>
							<td class="cell-msg">
								<div class="msg" title={ e.Message }>{ e.Message }</div>
								if e.ErrorType != nil || e.ErrorLocation != nil {
									<div class="sub">
										if e.ErrorType != nil {
											<button type="button" class="filter-link" { hxNav(s.WithFilter("error_type", *e.ErrorType).Href())... }>{ *e.ErrorType }</button>
										}
										if e.ErrorType != nil && e.ErrorLocation != nil {
											<span> · </span>
										}
										if e.ErrorLocation != nil {
											<button type="button" class="filter-link" { hxNav(s.WithFilter("error_location", *e.ErrorLocation).Href())... }>{ *e.ErrorLocation }</button>
										}
									</div>
								}
							</td>
							@FilterCell(deref(e.Release), "release", s)
							@FilterCell(deref(e.OsVersion), "os_version", s)
							@FilterCell(deref(e.DeviceModel), "device_model", s)
							@FilterCell(deref(e.UserID), "user_id", s)
							for _, t := range tags {
								@FilterCell(tagsMap(e.Tags)[t.Key], t.Key, s)
							}
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

func cellHref(s ViewState, col, value string) string {
	if col == "release" {
		return s.WithRelease(value).Href()
	}
	return s.WithFilter(col, value).Href()
}

// FilterCell: click sets `col=value`; empty renders a dash.
templ FilterCell(value, col string, s ViewState) {
	<td>
		if value != "" {
			<button type="button" class="cell-btn" title={ value } { hxNav(cellHref(s, col, value))... }>{ value }</button>
		} else {
			<span class="null-mark">—</span>
		}
	</td>
}
