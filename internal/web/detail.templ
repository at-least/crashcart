package web

import (
	"bytes"
	"encoding/json"
	"strconv"

	"github.com/newlix/crashcart/internal/db/sqlc"
	"github.com/newlix/crashcart/internal/sentry"
)

templ CrashIcon() {
	<svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M7.86 2h8.28L22 7.86v8.28L16.14 22H7.86L2 16.14V7.86z"></path>
		<path d="m15 9-6 6"></path>
		<path d="m9 9 6 6"></path>
	</svg>
}

templ CopyIcon() {
	<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		<rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
		<path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
	</svg>
}

func prettyJSON(raw json.RawMessage) string {
	var buf bytes.Buffer
	if json.Indent(&buf, raw, "", "  ") != nil {
		return string(raw)
	}
	return buf.String()
}

func crumbs(raw json.RawMessage) []sentry.Breadcrumb {
	var out []sentry.Breadcrumb
	_ = json.Unmarshal(raw, &out)
	if len(out) > 15 {
		out = out[len(out)-15:]
	}
	return out
}

func orDash(s string) string {
	if s == "" {
		return "—"
	}
	return s
}

// EventDetail is the sheet body for one event.
templ EventDetail(e sqlc.Event) {
	<div class="flex flex-col gap-5 p-5 pr-12 pb-8">
		<div class="sheet-section">
			<div class="flex flex-wrap items-center gap-1.5">
				<span class="level-badge" data-level={ levelKey(e.Level) }>{ e.Level }</span>
				if e.Level == "fatal" || (e.Handled != nil && !*e.Handled) {
					<span class="crash-badge">
						@CrashIcon()
						crashed
					</span>
				}
				if e.Handled != nil && *e.Handled {
					<span class="caught-mark">caught</span>
				}
				if e.Platform != nil {
					<span data-slot="badge" data-variant="outline" class="font-mono">{ *e.Platform }</span>
				}
				if e.Environment != nil {
					<span data-slot="badge" data-variant="outline" class="font-mono">{ *e.Environment }</span>
				}
			</div>
			<h2 class="sheet-title">{ e.Message }</h2>
			if e.ErrorType != nil || e.ErrorLocation != nil {
				<p class="font-mono text-xs text-muted-foreground">
					if e.ErrorType != nil {
						<span class="text-popover-foreground">{ *e.ErrorType }</span>
					}
					if e.ErrorType != nil && e.ErrorLocation != nil {
						{ " · " }
					}
					if e.ErrorLocation != nil {
						<span class="break-all">{ *e.ErrorLocation }</span>
					}
				</p>
			}
		</div>
		<div class="meta-grid">
			@Meta("Time", formatDateTime(e.OccurredAt), e.OccurredAt.UTC().Format("2006-01-02T15:04:05.000Z07:00"))
			@Meta("Release", deref(e.Release), "")
			@Meta("Device", deref(e.DeviceModel), "")
			@Meta("OS", deref(e.OsVersion), "")
			@Meta("User", userLabel(e.UserID), "")
			@Meta("Screen", deref(e.Screen), "")
			@Meta("SDK", deref(e.SdkName), "")
			@Meta("Device ID", deref(e.DeviceID), "")
			@Meta("Event ID", strconv.FormatInt(e.ID, 10), deref(e.EventID))
			if e.Fingerprint != nil {
				@Meta("Issue", *e.Fingerprint, "")
			}
		</div>
		@Breadcrumbs(crumbs(e.Breadcrumbs))
		@Tags(tagsMap(e.Tags))
		if len(e.Payload) > 0 {
			<div class="sheet-section">
				<div class="flex items-center">
					<p class="sheet-h">Raw payload</p>
					<button type="button" data-slot="button" data-variant="outline" data-size="xs" class="copy-btn" data-copy="#raw-payload" title="Copy JSON">
						@CopyIcon()
						Copy
					</button>
				</div>
				<pre id="raw-payload" class="code-block max-h-[360px]">{ prettyJSON(e.Payload) }</pre>
			</div>
		}
	</div>
}

func userLabel(u *string) string {
	if u == nil || *u == "" {
		return "anonymous"
	}
	return *u
}

func metaClass(v string) string {
	if v == "" {
		return "meta-v null-mark"
	}
	return "meta-v"
}

templ Meta(label, value, title string) {
	<div class="min-w-0">
		<div class="meta-k">{ label }</div>
		<div class={ metaClass(value) } title={ firstNonEmpty(title, value) }>{ orDash(value) }</div>
	</div>
}

func firstNonEmpty(a, b string) string {
	if a != "" {
		return a
	}
	return b
}

templ Tags(tags map[string]string) {
	if len(tags) > 0 {
		<div class="sheet-section">
			<p class="sheet-h">Tags</p>
			<div class="flex flex-wrap gap-1">
				for _, k := range sortedKeys(tags) {
					<span class="tag">{ k + ":" + tags[k] }</span>
				}
			</div>
		</div>
	}
}

func crumbLevel(l string) string {
	if l == "error" || l == "fatal" {
		return "error"
	}
	return ""
}

templ Breadcrumbs(list []sentry.Breadcrumb) {
	if len(list) > 0 {
		<div class="sheet-section">
			<p class="sheet-h">
				Breadcrumbs <span class="font-normal normal-case tracking-normal">({ strconv.Itoa(len(list)) } most recent)</span>
			</p>
			<div class="crumbs">
				for _, b := range list {
					<div class="crumb" data-level={ crumbLevel(b.Level) }>
						<span class="crumb-time">{ formatClock(b.Timestamp) }</span>
						<span class="min-w-0 break-words">
							if b.Category != "" {
								<span class="crumb-cat">{ b.Category + " " }</span>
							}
							{ b.Message }
						</span>
					</div>
				}
			</div>
		</div>
	}
}
