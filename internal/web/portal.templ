package web

import (
	"strings"

	"github.com/at-least/crashcart/internal/sentry"
)

// Portal: one card per project plus the create form.
templ Portal(cards []PortalCard) {
	<div class="flex flex-wrap items-end justify-between gap-3">
		<div>
			<h1 class="page-title">Projects</h1>
			<p class="page-desc">Crash tracking for every app that sends to this CrashCart.</p>
		</div>
	</div>
	if len(cards) == 0 {
		@Empty("No projects yet", "Create one below and point your Sentry SDK at its DSN.")
	} else {
		<div class="portal-grid">
			for _, c := range cards {
				<a data-slot="card" data-size="sm" class="portal-card" href={ u("/p/" + c.P.Slug) }>
					<header data-slot="card-header">
						<div data-slot="card-title" class="portal-name">{ c.P.Name }</div>
						<div data-slot="card-description" class="font-mono text-xs">
							{ c.P.Slug }
							if c.P.Platform != nil {
								{ " · " + *c.P.Platform }
							}
							if c.Mismatch {
								<span data-slot="badge" data-variant="destructive" class="ml-2" title={ "received " + strings.Join(c.Received, ", ") }>platform mismatch</span>
							} else if len(c.Received) > 0 && c.P.Platform == nil {
								{ " · " + strings.Join(c.Received, ", ") }
							}
						</div>
					</header>
					<section data-slot="card-content" class="portal-stats">
						<div><span class="stat-k">Unhandled 24h</span><span class="stat-v" data-level={ unhandledLevel(c.Unhandled24h) }>{ compact(c.Unhandled24h) }</span></div>
						<div><span class="stat-k">Crash-free</span><span class="stat-v">{ c.CrashFree }</span><span class="stat-sub">{ orDash(c.LatestRelease) }</span></div>
						<div><span class="stat-k">Open issues</span><span class="stat-v">{ compact(c.OpenIssues) }</span></div>
					</section>
				</a>
			}
		</div>
	}
	<section class="mt-10 max-w-lg">
		<h2 class="section-title">Create project</h2>
		<form class="mt-3 grid gap-3" hx-post="/projects" hx-swap="none" hx-disabled-elt="find button">
			<div class="grid gap-1">
				<label data-slot="label" for="np-name">Name</label>
				<input data-slot="input" id="np-name" name="name" required placeholder="My App"/>
			</div>
			<div class="grid gap-1">
				<label data-slot="label" for="np-slug">Slug</label>
				<input data-slot="input" id="np-slug" name="slug" required pattern="[a-z0-9][a-z0-9-]*" placeholder="my-app" title="lowercase letters, digits, dashes"/>
			</div>
			<div class="grid gap-1">
				<label data-slot="label" for="np-platform">Platform</label>
				<span data-slot="native-select-wrapper">
					<select data-slot="native-select" id="np-platform" name="platform">
						<option value="">unspecified</option>
						for _, p := range sentry.Families {
							<option value={ p }>{ p }</option>
						}
					</select>
					@ChevronIcon()
				</span>
			</div>
			<div>
				<button type="submit" data-slot="button" data-size="sm">Create project</button>
			</div>
			<p class="form-error" data-form-error hidden></p>
		</form>
	</section>
}

func unhandledLevel(n int64) string {
	if n > 0 {
		return "fatal"
	}
	return ""
}
