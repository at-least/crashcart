package web

// Layout is the HTML document: anti-flash theme script, stylesheet, the
// vendored scripts, and the detail sheet portal (outside #shell so the
// 30s poll swap doesn't close an open sheet).
templ Layout() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>CrashCart — Log Viewer</title>
			<script>
				try {
					var t = localStorage.getItem("cc-theme");
					if (!t) t = window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
					if (t === "dark") document.documentElement.classList.add("dark");
				} catch (e) {}
			</script>
			<link rel="stylesheet" href={ templ.SafeURL(assetURL("app.css")) }/>
			<meta name="htmx-config" content={ `{"includeIndicatorStyles": false}` }/>
			<script src={ assetURL("htmx.min.js") } defer></script>
			<script src={ assetURL("chart.umd.min.js") } defer></script>
			<script src={ assetURL("radix-kernel.min.js") } defer></script>
			<script src={ assetURL("shadless.min.js") } defer></script>
			<script src={ assetURL("app.js") } defer></script>
		</head>
		<body>
			{ children... }
			<div id="sheet-portal" hidden>
				<div data-slot="sheet-overlay" aria-hidden="true"></div>
				<div id="sheet" role="dialog" aria-modal="true" data-slot="sheet-content" data-side="right" aria-label="Event detail">
					<div id="sheet-body" class="flex-1 overflow-y-auto">
						<p class="animate-pulse p-4 text-xs text-muted-foreground">loading…</p>
					</div>
					<button type="button" class="sheet-content-button" id="sheet-close" aria-label="Close">
						<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
							<path d="M18 6 6 18M6 6l12 12"></path>
						</svg>
					</button>
				</div>
			</div>
		</body>
	</html>
}

// NetError is the network-failure banner toggled by app.js on htmx errors.
templ NetError() {
	<div id="net-error" hidden>
		<div class="mx-auto w-full max-w-[1400px] px-4 pt-3">
			<div data-slot="alert" data-variant="destructive" role="alert" class="error-box">
				@WarnIcon()
				<p data-slot="alert-description">Network error — last action failed. Check your connection.</p>
			</div>
		</div>
	</div>
}
