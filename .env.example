# Copy to .env next to docker-compose.yml. .env is git-ignored.
# Generate the random strings with: openssl rand -hex 32

# Postgres password (used by both the db and crashcart services)
POSTGRES_PASSWORD=change-me

# The HTTPS address your apps use. Shown in DSNs and alert links.
PUBLIC_URL=https://crashcart.example.com

# Access is not configured here: open the viewer once to create the first
# account (/setup); users and API keys are managed on its Account page.

# Days to keep raw events.
RETENTION_DAYS=30

# Only if you use a browser SDK and want to restrict which sites may send events.
# CORS_ORIGIN=https://shop.example.com

# With the symbolicate service enabled in docker-compose.yml (iOS dSYMs).
# SYMBOLICATE_URL=http://symbolicate:8080
