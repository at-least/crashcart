# Postgres connection (required)
DATABASE_URL="postgres://crashcart:crashcart@localhost:5432/crashcart?sslmode=disable"

# HTTP listen address
LISTEN_ADDR=":8080"

# API keys for /api/* routes (comma-separated). Unset = open access (dev only).
API_KEYS="sk-test-key-001"

# Token for ingest (?token= / sentry_key / X-Sentry-Auth). Unset = open (dev only).
INGEST_TOKEN="dev-ingest-token"

# Max requests per minute per key/IP (0 disables)
RATE_LIMIT="100"

# Scrub emails/phones/cards and mask user ids before storing
PII_REDACT="false"

# Keep ratio for info/debug events (1.0 = keep all)
SAMPLE_RATE="1.0"

# Data retention in days
RETENTION_DAYS="30"

# Extra searchable viewer columns from Sentry tags: key:Label,key:Label
CUSTOM_TAGS=""

# Multi-instance portal: Name|https://origin|api-key,…
DEPLOYMENTS=""

# dSYM symbolication sidecar (container/symbolicate)
SYMBOLICATE_URL=""

# Alert channels (comma-separated)
# TELEGRAM_BOT_TOKEN="123:abc"
# TELEGRAM_CHAT_IDS="-100123"
# ALERT_WEBHOOKS="https://hooks.slack.com/..."
# ALERT_EMAILS="alerts@example.com"
# EMAIL_FROM="crashcart@example.com"
# SMTP_ADDR="smtp.example.com:587"
# SMTP_USER=""
# SMTP_PASSWORD=""
